table 'main dim_date'
	lineageTag: a08017dc-d317-4605-84e2-bd45e5a14c56

	measure Duracion_Promedio_Horas =
			
			AVERAGEX(
			    'main fact_fires',
			    VAR FechaInicio = 'main fact_fires'[DISCOVERY_DATE] + TIMEVALUE('main fact_fires'[DISCOVERY_TIME])
			    VAR FechaFin = 'main fact_fires'[CONT_DATE] + TIMEVALUE('main fact_fires'[CONT_TIME])
			    VAR DifMinutos = DATEDIFF(FechaInicio, FechaFin, MINUTE)
			    RETURN
			        IF(DifMinutos < 0, (DifMinutos + 1440) / 60.0, DifMinutos / 60.0)
			)
		lineageTag: 14300864-b82f-49d7-bad6-2c7705197ada

		annotation PBI_FormatHint = {"isGeneralNumber":true}

