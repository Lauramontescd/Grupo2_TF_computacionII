table 'main fact_fires'
	lineageTag: aa98c816-26ad-4e6d-bcb2-e21f521d28aa

	measure Total_Incendios = COUNTROWS('main fact_fires')
		formatString: 0
		lineageTag: b0b44782-bfcb-4602-be6b-08c088f5efce

	measure Total_Acres_Quemados = SUM('main fact_fires'[FIRE_SIZE])
		lineageTag: 8d4a9872-4b43-4402-a297-4d702bfbd206

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Acumulado por Clase' = ```
			
			VAR TotalGeneral = CALCULATE(
			    [Total_Incendios], 
			    ALLSELECTED('main fact_fires'[FIRE_SIZE_CLASS])
			)
			VAR Acumulado = CALCULATE(
			    [Total_Incendios],
			    FILTER(
			        ALLSELECTED('main fact_fires'[FIRE_SIZE_CLASS]),
			        'main fact_fires'[FIRE_SIZE_CLASS] <= MAX('main fact_fires'[FIRE_SIZE_CLASS])
			    )
			)
			RETURN
			    DIVIDE(Acumulado, TotalGeneral, 0)
			```
		lineageTag: 2ffe4cd6-474b-4dfc-9171-5a2c6f3aa5ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

